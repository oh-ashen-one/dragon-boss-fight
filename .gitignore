# Reproducible licensed audio, retained in private asset release.
Unreal/Veyr/Content/Audio/Overhaul/*.pcm

# Owner-supplied music and generated vocal masters use acquisition receipts.
Unreal/Veyr/Content/Audio/OwnerScore20261102/
Unreal/Veyr/Content/Audio/Fish20261102/

# Raw Epic Paragon FX (free to use, not to redistribute; this repository is public). Copied locally by
# tools/unreal/paragon_fx_closure.py --copy-to Unreal/Veyr/Content; never commit.
Unreal/Veyr/Content/Paragon*/
# Quality goal E (Greystone): Epic Paragon pack copied from the launcher VaultCache, our baked Greystone assets and
# the GASP mannequin content are local-only (free Epic content, not redistributable in a public repository).
Unreal/**/Content/ParagonGreystone/
Unreal/**/Content/Characters/Greystone/
Unreal/**/Content/Characters/UEFN_Mannequin/
Unreal/**/Content/Characters/Paragon/

# B1 generated supplement (fal.ai sound effects, not CC0 recordings): restore per docs/audio-20261118/README.md
Unreal/Veyr/Content/Audio/Recorded20261118/*_g[0-9]*.pcm
